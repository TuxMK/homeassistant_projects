      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Kosten im Verlauf (€)",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "datasource": {
                        "name": "afy0tg4a3q0hsc"
                      },
                      "group": "mysql",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT bucket AS time,\n       (reading - LAG(reading) OVER (ORDER BY bucket)) * $price AS `Kosten (€)`\nFROM (\n  SELECT $__timeGroup(ts, $__interval) AS bucket,\n         MAX(value)                    AS reading\n  FROM states\n  WHERE entity_id = '$device'\n    AND $__timeFilter(ts)\n  GROUP BY bucket\n) b\nORDER BY bucket"
                      },
                      "version": "v0"
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
