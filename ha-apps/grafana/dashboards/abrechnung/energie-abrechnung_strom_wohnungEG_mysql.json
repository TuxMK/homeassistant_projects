        "spec": {
          "id": 1,
          "title": "Gesamtverbrauch im Zeitraum (kw/h)",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "datasource": {
                        "name": "afy0tg4a3q0hsc"
                      },
                      "group": "mysql",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT $__timeGroupAlias(ts, $__interval),\n       MAX(value) AS `kWh`\nFROM states\nWHERE entity_id = '$device'\n  AND $__timeFilter(ts)\nGROUP BY time\nORDER BY time"
