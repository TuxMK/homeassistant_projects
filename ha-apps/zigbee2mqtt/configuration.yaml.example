# Zigbee2MQTT configuration - relevant changes
#
# This file shows ONLY the changes that avoid a
# binding table overflow on EFR32MG21-based coordinators.
#
# Add these sections to your existing configuration.yaml.

# ============================================================
# 1. Add under 'advanced:':
# ============================================================
advanced:
  # Disables the automatic reporting setup
  # Prevents some (but not all) configure attempts
  report: false

# ============================================================
# 2. Add a new section (if not present):
# ============================================================
# Prevents configure when a device joins
# Does not work reliably for every device
device_options:
  configure_on_join: false

# ============================================================
# 3. Load the external converter - MUST come before 'devices:'!
# ============================================================
# The converter overrides the device definition and
# removes the configure function entirely
external_converters:
  - develco_override.js

# ============================================================
# Order in configuration.yaml:
# ============================================================
# mqtt:
# serial:
# advanced:
#   report: false        <-- NEW
# device_options:        <-- NEW
#   configure_on_join: false
# frontend:
# homeassistant:
# external_converters:   <-- NEW
#   - develco_override.js
# devices:
