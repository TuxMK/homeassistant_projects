{# ============================================================================
   Security Entities - central entity patterns for security devices

   This file defines every entity pattern for security devices.
   New devices are picked up automatically as soon as they match a pattern.

   Installation:
   1. Copy the file to /config/custom_templates/security_entities.jinja
   2. Import it in templates/automations with:
      {% from 'security_entities.jinja' import alarm_rauch_sensoren %}

   ============================================================================ #}


{# --------------------------------------------------------------------------
   ALARM SENSORS (smoke, CO, etc.)
   -------------------------------------------------------------------------- #}

{# Smoke alarm sensors - binary sensors that detect smoke #}
{% macro alarm_rauch_sensoren() %}
{{ states.binary_sensor
   | selectattr('entity_id', 'search', '(co_alarm_.*_rauch|feueralarm_.*_(smoke|rauch))')
   | map(attribute='entity_id')
   | list
   | to_json }}
{% endmacro %}


{# CO alarm sensors - carbon monoxide readings and carbon monoxide binary sensors #}
{% macro alarm_co_sensoren() %}
{% set sensoren_kohlenmonoxid = states.sensor
   | selectattr('entity_id', 'search', 'co_alarm_.*_kohlenmonoxid')
   | map(attribute='entity_id')
   | list %}
{% set sensoren_carbon_monoxide = states.binary_sensor
   | selectattr('entity_id', 'search', 'co_alarm_.*_carbon_monoxide')
   | map(attribute='entity_id')
   | list %}
{{ (sensoren_kohlenmonoxid + sensoren_carbon_monoxide) | to_json }}
{% endmacro %}


{# --------------------------------------------------------------------------
   LEAK SENSORS (water leak)
   -------------------------------------------------------------------------- #}

{# Leak sensors - binary sensors that detect water leaks #}
{% macro alarm_leckage_sensoren() %}
{{ states.binary_sensor
   | selectattr('entity_id', 'search', 'leckagealarm_.*_water_leak')
   | map(attribute='entity_id')
   | list
   | to_json }}
{% endmacro %}


{# --------------------------------------------------------------------------
   ALARM BATTERY SENSORS
   -------------------------------------------------------------------------- #}

{# Alarm battery sensors - battery level of the security devices #}
{% macro alarm_batterie_sensoren() %}
{{ states.sensor
   | selectattr('entity_id', 'search', '(co_alarm_.*_(batterie|battery)|feueralarm_.*_batter|leckagealarm_.*_battery)')
   | map(attribute='entity_id')
   | list
   | to_json }}
{% endmacro %}


{# --------------------------------------------------------------------------
   ALARM FAULT SENSORS
   -------------------------------------------------------------------------- #}

{# Alarm fault sensors - device faults and end of life #}
{% macro alarm_fehler_sensoren() %}
{{ states.binary_sensor
   | selectattr('entity_id', 'search', '(co_alarm_.*_is_life_end|feueralarm_.*_(fault|is_life_end))')
   | map(attribute='entity_id')
   | list
   | to_json }}
{% endmacro %}


{# --------------------------------------------------------------------------
   ALARM-PANELS
   -------------------------------------------------------------------------- #}

{# Alarm panels - the alarm control panels #}
{% macro alarm_panels() %}
{{ [
  'alarm_control_panel.alarm_zentrale',
  'alarm_control_panel.feuer_co_alarm',
  'alarm_control_panel.leckage_alarm'
] | to_json }}
{% endmacro %}


{# --------------------------------------------------------------------------
   COMBINED QUERIES
   -------------------------------------------------------------------------- #}

{# All alarm sensors (for the overall status) #}
{% macro alarm_alle_sensoren() %}
{{ ((alarm_rauch_sensoren() | from_json) +
    (alarm_co_sensoren() | from_json) +
    (alarm_leckage_sensoren() | from_json) +
    (alarm_batterie_sensoren() | from_json) +
    (alarm_fehler_sensoren() | from_json)) | to_json }}
{% endmacro %}
